{
  "version": 2,
  "functions": {
    "api/**/*.ts": {
      "includeFiles": "{db.js,api/_db.js,api/_db.ts,orders.json,deleted_orders.json,settings.json,reviews.json,catalogue.json}"
    }
  },
  "rewrites": [
    {
      "source": "/api/orders/:id",
      "destination": "/api/orders?id=:id"
    },
    {
      "source": "/api/(.*)",
      "destination": "/api/$1"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
